# Required for Firestore mode
FIREBASE_SERVICE_ACCOUNT=/absolute/path/service-account.json
FIRESTORE_COLLECTION=vpn_servers

# Or use MongoDB mode
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=nova_vpn
MONGO_COLLECTION=vpn_servers

# Health policy
CHECK_INTERVAL_SECONDS=300
PING_TIMEOUT_SECONDS=2
PORT_TIMEOUT_SECONDS=2
MAX_FAILURES=2
WG_DEFAULT_PORT=51820
